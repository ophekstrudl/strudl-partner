# Supabase — same project as the user app + back office.
# NEXT_PUBLIC_* are safe to expose (used by the browser to fire magic links).
# SUPABASE_SERVICE_ROLE_KEY is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HS256 key that verifies stamp-QR JWTs issued by the user app. Must match
# the value set in Strudl-app's .env.local — same secret, both surfaces.
# Generate on the app side with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
STAMP_TOKEN_SECRET=
